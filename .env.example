# Copy this file to .env and fill in real values. Never commit .env.
# Shared secret that the Gmail add-on sends in the X-API-Key header.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=change-me
PORT=3000
# Network intel: "replay" (default, saved files, works offline) or "live" (real passive lookups).
INTEL_MODE=replay
